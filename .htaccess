# OVIA — protections de base (Apache / LiteSpeed, fonctionne chez Hostinger)

# Empêche de télécharger le journal d'erreurs et le fichier de réglages
# depuis un navigateur (ils restent lisibles par PHP côté serveur).
<IfModule mod_authz_core.c>
  <FilesMatch "^(\.mail-error\.log|config\.php)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(\.mail-error\.log|config\.php)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# Page d'accueil du site
DirectoryIndex index.html

# Le formulaire poste vers /api/send (meme URL que sur Vercel).
# Chez Hostinger, on redirige cette URL vers le script PHP.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/send/?$ send.php [L]
</IfModule>
