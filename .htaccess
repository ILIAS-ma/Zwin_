# OVIA — protections de base (Apache / LiteSpeed, fonctionne chez Hostinger)

# Empêche de télécharger le journal d'erreurs et le fichier de réglages
# depuis un navigateur (ils restent lisibles par PHP côté serveur).
<IfModule mod_authz_core.c>
  <FilesMatch "^(\.mail-error\.log|config\.php)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(\.mail-error\.log|config\.php)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# Page d'accueil du site
DirectoryIndex index.html
